      "title": "Approved restoration evidence",
      "value": 1785.0,
      "value_unit": "candidates",
      "conclusion": "All 1,785 approved candidates remain available for filtering and case-level inspection.",
      "limitation": "Candidate count is not an independent sample-size claim because repeated seeds and models share cases."
    },
    {
      "finding_id": "finding_d57ce83c3ee8f0ab3b3ad70a",
      "title": "Strongest general benchmark result",
      "value": 10.0,
      "value_unit": "of 11 quality anchors",
      "conclusion": "LaMa ranks first on 10 of 11 quality anchors. Within this controlled benchmark, it is the strongest general restoration baseline across error, colour, perceptual, feature, seam, texture, and structural-affinity evidence.",
      "limitation": "Anchor wins are metric-specific benchmark results, not conservation approval or historical authenticity."
    },
    {
      "finding_id": "finding_be0ba692aeac9c0494a5df23",
      "title": "One metric changes the winner",
      "value": 1.0,
      "value_unit": "of 11 quality anchors",
      "conclusion": "OpenCV Telea narrowly leads crop SSIM, while LaMa leads the other ten anchors. SSIM alone would therefore give an incomplete account of restoration quality.",
      "limitation": "The result demonstrates metric disagreement; it does not make either model universally correct."
    },
    {
      "finding_id": "finding_ff1f99bcdade39cf8ed81b9e",
      "title": "Repeated-run uncertainty coverage",
      "value": 165.0,
      "value_unit": "uncertainty groups",
      "conclusion": "Repeated-seed evidence covers 130 canonical groups and 35 damage-size groups for Stable Diffusion.",
      "limitation": "Seed variability is an empirical uncertainty proxy, not calibrated confidence."
    },
    {
      "finding_id": "finding_4549a08b17e791b97d59ba89",
      "title": "SDXL remains bounded evidence",
      "value": 10.0,
      "value_unit": "candidates",
      "conclusion": "SDXL contributes ten completed cases for qualitative and bounded comparison, not a fourth full benchmark.",
      "limitation": "SDXL results must not be generalized to all 410 restoration-eligible cases."
    },
    {
      "finding_id": "finding_3b9d3b11c0241b5a7624f94a",
      "title": "Human review remains central",
      "value": 95.4,
      "value_unit": "% of candidates",
      "conclusion": "1,703 of 1,785 candidates trigger conservative review guidance. Automated restoration should support inspection, not replace expert judgement.",
      "limitation": "Computational review flags are diagnostic rules, not expert annotations or conservation ground truth."
    },
    {
      "finding_id": "finding_0463745ce8b0a315e377b4a5",
      "title": "No universal restoration score",
      "value": 0.0,
      "value_unit": "approved combined scores",
      "conclusion": "The evaluation keeps metric families, regions, uncertainty, and failure evidence separate so that important disagreements remain visible.",
      "limitation": "The dashboard supports evidence review and does not produce conservation approval."
    }
