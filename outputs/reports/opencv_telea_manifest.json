    {
      "limitation_id": "telea_local_interpolation",
      "scope": "all",
      "limitation": "OpenCV Telea fills masked regions using local image information and does not infer historically verified missing content.",
      "reporting_consequence": "Treat Telea as a classical baseline rather than a conservation-grade restoration method."
