# Supervisor-meeting materials. Keep editable sources and assets local,
# but version the two approved, self-contained PDF guides.
docs/supervisor/*
docs/supervisor/Next_Steps.docx
!docs/supervisor/Supervisor_Dashboard_Walkthrough_Guide.pdf
!docs/supervisor/Next_Steps.pdf
.codex_tmp/

# Controlled-300 storage boundary (Notebook 12 onward).
# Complete notebook-owned evidence remains local. N12-15 and the approved
# N16/N17/N19 indexed-bundle releases are externally verified; N20 uses the
# same diagnostics release gate. Other bulk publication waits for the pre-N34
# storage review. GitHub
# retains compact scientific evidence; N01-11 are the full-output checkpoint.
/outputs/1[2-9]_*/images/
/outputs/12a_*/images/
/outputs/2[0-9]_*/images/
/outputs/3[0-6]_*/images/

# N16/N17 generated presentation PNGs stay local (N16's exact bytes are bundled).
/outputs/16_difference_maps_and_spatial_diagnostics/figures/
/outputs/17_local_consistency_metrics/figures/

# Canonical bulk tables remain local when too large for ordinary Git hosting.
# N16's metrics are in its verified release; N17 remains local pending release.
/outputs/13_classical_metrics/metrics/classical_metrics.csv
/outputs/15_feature_similarity/data/embeddings.npz
/outputs/16_difference_maps_and_spatial_diagnostics/metrics/spatial_diagnostics.csv
/outputs/17_local_consistency_metrics/metrics/local_consistency.csv
/outputs/20_semantic_and_structural_consistency/metrics/semantic_structural_metrics.csv
/outputs/20_semantic_and_structural_consistency/data/semantic_maps.npz

# Upload scratch metadata is not scientific evidence, even while publication
# is paused. The failed N16 upload cache was removed after the policy change.
/outputs/16_difference_maps_and_spatial_diagnostics/.cache/
/outputs/17_local_consistency_metrics/.cache/
